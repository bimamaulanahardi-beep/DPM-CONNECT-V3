datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id       String  @id @default(uuid())
  nim      String  @unique
  name     String
  email    String  @unique
  password String
  role     String
  komisi   String?
  jabatan  String?
  avatar   String?
  phone    String?
  angkatan String?
  prodi    String?
}

model Sidang {
  id              String   @id
  judul           String
  jenis           String
  status          String
  tanggal         String
  waktu_mulai     String
  waktu_selesai   String?
  lokasi          String
  link_daring     String?
  komisi          String?
  agenda          String   // Stringified JSON array
  peserta         String   // Stringified JSON array
  notulensi       String?
  quorum_required Int
  quorum_achieved Int
  created_by      String
  created_at      String

  @@index([status])
  @@index([tanggal])
}

model Legislasi {
  id               String   @id
  nomor            String?
  judul            String
  jenis            String
  status           String
  komisi           String
  pengaju          String
  tanggal_diajukan String
  tanggal_disahkan String?
  isi_ringkasan    String
  konten           String?
  tags             String   // Stringified JSON array
  revisi_ke        Int
  approved_by      String?
  sidang_id        String?

  @@index([status])
}

model Aspirasi {
  id                    String             @id
  kode_tracking         String             @unique
  judul                 String
  deskripsi             String
  kategori              String
  status                String
  is_anonim             Boolean
  nama_pengaju          String?
  nim_pengaju           String?
  email_pengaju         String?
  tanggal_masuk         String
  tanggal_update        String
  catatan_tindak_lanjut String?
  petugas               String?
  lampiran              String? // Stringified JSON array
  timeline              AspirasiTimeline[]

  @@index([status])
  @@index([tanggal_masuk])
}

model AspirasiTimeline {
  id          String   @id @default(uuid())
  aspirasi_id String
  status      String
  keterangan  String
  tanggal     String
  petugas     String?
  aspirasi    Aspirasi @relation(fields: [aspirasi_id], references: [id], onDelete: Cascade)
}

model ProgramKerjaBEM {
  id                  String  @id
  nama                String
  divisi              String
  deskripsi           String
  target              String
  tanggal_mulai       String
  tanggal_selesai     String
  status              String
  progress_percentage Int
  bukti_urls          String? // Stringified JSON array
  skor_evaluasi       Int?
  catatan_dpm         String?
  catatan_bem         String?
  penanggung_jawab    String
}

model Voting {
  id                 String  @id
  judul              String
  deskripsi          String
  status             String
  sidang_id          String?
  tanggal_mulai      String?
  tanggal_selesai    String?
  quorum_required    Int
  total_pemilih      Int
  jenis              String
  opsi_multipilih    String? // Stringified JSON array
  hasil_setuju       Int
  hasil_tidak_setuju Int
  hasil_abstain      Int
  hasil_total        Int
  created_by         String
  records            VoteRecord[]

  @@index([status])
}

model VoteRecord {
  id        String   @id @default(uuid())
  voting_id String
  user_nim  String
  pilihan   String? 
  tanggal   String
  voting    Voting   @relation(fields: [voting_id], references: [id], onDelete: Cascade)
  
  @@unique([voting_id, user_nim])
}

model Surat {
  id                String  @id
  nomor             String
  perihal           String
  jenis             String
  status            String
  dari              String
  kepada            String
  tanggal           String
  isi_singkat       String
  lampiran          String? // Stringified JSON array
  tanda_tangan      String? @db.Text
  disposisi_kepada  String?
  disposisi_catatan String?
  created_by        String

  @@index([status])
  @@index([tanggal])
}

model Notifikasi {
  id      String  @id @default(uuid())
  judul   String
  pesan   String
  jenis   String
  is_read Boolean
  tanggal String
  link    String?
}

model AuditLog {
  id         String @id @default(uuid())
  user       String
  aksi       String
  modul      String
  detail     String
  ip_address String
  tanggal    String
}

model FileStorage {
  id         String @id @default(uuid())
  fileId     String @unique
  filename   String
  mimeType   String
  sizeBytes  Int
  dataUri    String @db.Text
  uploadedBy String
  tanggal    String
}

// ============================================
// MODUL PEMILU RAYA (PEMIRA) V2.0
// ============================================

model PemiraEvent {
  id              String   @id @default(uuid())
  judul           String
  deskripsi       String
  tanggal_mulai   String
  tanggal_selesai String
  status          String   @default("draft") // draft, aktif, selesai
  total_dpt       Int      @default(0)
  created_by      String
  created_at      DateTime @default(now())
  
  candidates      PemiraCandidate[]
  records         PemiraVoteRecord[]

  @@index([status])
}

model PemiraCandidate {
  id              String   @id @default(uuid())
  pemira_id       String
  nomor_urut      Int
  nama_ketua      String
  nama_wakil      String?
  foto_url        String?
  visi            String   @db.Text
  misi            String   @db.Text
  total_suara     Int      @default(0)
  
  pemira          PemiraEvent @relation(fields: [pemira_id], references: [id], onDelete: Cascade)
  
  @@index([pemira_id])
}

model PemiraVoteRecord {
  id              String   @id @default(uuid())
  pemira_id       String
  user_nim        String
  voter_nama      String?
  voter_prodi     String?
  tanggal         String
  
  pemira          PemiraEvent @relation(fields: [pemira_id], references: [id], onDelete: Cascade)
  
  @@unique([pemira_id, user_nim])
}

// ============================================
// MODUL PERIZINAN KEGIATAN
// ============================================

model IzinKegiatan {
  id                String                  @id @default(uuid())
  kode              String                  @unique
  nama_kegiatan     String
  penyelenggara     String
  penanggung_jawab  String
  no_hp_pj          String
  email_pj          String?
  tanggal_mulai     String
  tanggal_selesai   String
  waktu_mulai       String
  waktu_selesai     String
  lokasi            String
  deskripsi         String
  estimasi_peserta  Int
  status            String                  @default("menunggu") // menunggu, disetujui, ditolak, perlu_revisi
  catatan_dpm       String?
  diproses_oleh     String?
  tanggal_diajukan  String
  tanggal_diproses  String?
  lampiran          String?
  timeline          IzinKegiatanTimeline[]

  @@index([status])
  @@index([tanggal_mulai])
}

model IzinKegiatanTimeline {
  id          String       @id @default(uuid())
  izin_id     String
  status      String
  keterangan  String
  tanggal     String
  petugas     String?
  izin        IzinKegiatan @relation(fields: [izin_id], references: [id], onDelete: Cascade)
}

// ============================================
// MODUL REFERENDUM DIGITAL
// ============================================

model Referendum {
  id               String            @id @default(uuid())
  judul            String
  deskripsi        String
  pertanyaan       String
  opsi             String            // Stringified JSON array of options
  status           String            @default("draft") // draft, aktif, selesai
  tanggal_mulai    String
  tanggal_selesai  String
  total_pemilih    Int               @default(0)
  is_publik        Boolean           @default(false)
  created_by       String
  created_at       String
  votes            ReferendumVote[]

  @@index([status])
}

model ReferendumVote {
  id            String     @id @default(uuid())
  referendum_id String
  user_nim      String
  pilihan       String
  tanggal       String
  referendum    Referendum @relation(fields: [referendum_id], references: [id], onDelete: Cascade)

  @@unique([referendum_id, user_nim])
}

// ============================================
// MODUL LAPORAN LPJ DIGITAL
// ============================================

model LaporanLPJ {
  id              String       @id @default(uuid())
  judul           String
  periode         String       // e.g., "2025/2026"
  lembaga         String       // e.g., "DPM ITB Riau", "BEM ITB Riau"
  ketua           String
  status          String       @default("draft") // draft, diterbitkan
  ringkasan       String       @db.Text
  created_by      String
  created_at      String
  updated_at      String
  sections        LPJSection[]

  @@index([status])
  @@index([periode])
}

model LPJSection {
  id          String     @id @default(uuid())
  lpj_id      String
  judul       String
  konten      String     @db.Text
  urutan      Int
  lpj         LaporanLPJ @relation(fields: [lpj_id], references: [id], onDelete: Cascade)
}

